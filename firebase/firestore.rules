rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function isMember(householdId) {
      return isAuth() && exists(/databases/$(database)/documents/households/$(householdId)/members/$(request.auth.uid));
    }

    function isOwner(householdId) {
      return isAuth() && get(/databases/$(database)/documents/households/$(householdId)/members/$(request.auth.uid)).data.role == 'owner';
    }

    // User profiles — anyone authenticated can read, only yourself can write
    match /userProfiles/{uid} {
      allow read: if isAuth();
      allow write: if isAuth() && request.auth.uid == uid;
    }

    // User household mapping — only yourself can read/write
    match /userHouseholds/{uid} {
      allow read, write: if isAuth() && request.auth.uid == uid;
    }

    // Invites — anyone can read (to validate a link), members can create
    match /invites/{token} {
      allow read: if true;
      allow create: if isAuth() && request.resource.data.createdBy == request.auth.uid;
    }

    // Households
    match /households/{householdId} {
      allow read: if isMember(householdId);
      allow create: if isAuth();
      allow update: if isOwner(householdId);

      // Members subcollection
      match /members/{uid} {
        allow read: if isMember(householdId);
        allow create: if isAuth() && request.auth.uid == uid;
        allow delete: if isOwner(householdId) && request.auth.uid != uid;
      }

      // Shopping items
      match /shoppingItems/{itemId} {
        allow read, update, delete: if isMember(householdId);
        allow create: if isMember(householdId) && request.resource.data.addedBy == request.auth.uid;
      }

      // Calendar connection (single doc 'main')
      match /calendarConnections/{docId} {
        allow read: if isMember(householdId);
        allow write: if isMember(householdId);
      }
    }
  }
}
